# Operational database for the running app: PostgreSQL 16 with PostGIS.
# Tests override DATABASE_URL with a temporary SQLite file and do not need Docker.
# The password below is a local development placeholder, not a production secret.
DATABASE_URL=postgresql+psycopg://hydroflow:hydroflow_dev@localhost:5432/hydroflow

# Rebuildable caches. A write here never joins the operational transaction.
# Paths are relative to the repository root.
HYDRO_FEATURES_CACHE=data/cache/hydro_features.sqlite
ROAD_CACHE=data/cache/road_cache.sqlite

OPENTOPOGRAPHY_API_KEY=

# Optional: override served flood models (defaults: ml/models/bago_flood_model.*)
# MODEL_PATH=
# MODEL_METADATA_PATH=
# SECONDARY_MODEL_PATH=
# SECONDARY_MODEL_METADATA_PATH=
